/* ===== Variables & Reset ===== */
:root {
  --primary: #0d9488;
  --primary-dark: #0f766e;
  --primary-light: #14b8a6;
  --accent: #f59e0b;
  --bg: #f8fafc;
  --bg-alt: #f1f5f9;
  --card: #ffffff;
  --text: #0f172a;
  --text-muted: #64748b;
  --border: #e2e8f0;
  --success: #10b981;
  --error: #ef4444;
  --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.07), 0 2px 4px -2px rgb(0 0 0 / 0.05);
  --radius: 12px;
  --nav-h: 64px;
}

[data-theme="dark"] {
  --bg: #0f172a;
  --bg-alt: #1e293b;
  --card: #1e293b;
  --text: #f1f5f9;
  --text-muted: #94a3b8;
  --border: #334155;
  --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.3);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: var(--nav-h);
}

body {
  font-family: 'Inter', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  transition: background 0.3s, color 0.3s;
}

.container {
  width: min(1120px, 92%);
  margin-inline: auto;
}

/* ===== Navbar ===== */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: color-mix(in srgb, var(--card) 90%, transparent);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  height: var(--nav-h);
}

.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 700;
  font-size: 1.25rem;
  color: var(--text);
  text-decoration: none;
}

.logo-icon {
  font-size: 1.5rem;
}

.nav-links {
  display: flex;
  gap: 1.5rem;
  list-style: none;
}

.nav-links a {
  color: var(--text-muted);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.95rem;
  transition: color 0.2s;
}

.nav-links a:hover,
.nav-links a.active {
  color: var(--primary);
}

.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
}

.nav-toggle span {
  width: 22px;
  height: 2px;
  background: var(--text);
  transition: 0.3s;
}

.theme-toggle {
  background: var(--bg-alt);
  border: 1px solid var(--border);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  cursor: pointer;
  font-size: 1.1rem;
  display: grid;
  place-items: center;
}

/* ===== Hero ===== */
.hero {
  padding: 4.5rem 0 3.5rem;
  background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 8%, var(--bg)), var(--bg));
  text-align: center;
}

.hero h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 5vw, 3.2rem);
  line-height: 1.2;
  margin-bottom: 1rem;
}

.accent {
  color: var(--primary);
}

.hero-sub {
  max-width: 580px;
  margin: 0 auto 2rem;
  color: var(--text-muted);
  font-size: 1.1rem;
}

.hero-cta {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
}

.hero-stats {
  display: flex;
  justify-content: center;
  gap: 2.5rem;
  flex-wrap: wrap;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat strong {
  font-size: 1.6rem;
  color: var(--primary);
}

.stat span {
  font-size: 0.85rem;
  color: var(--text-muted);
}

/* ===== Buttons ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.7rem 1.4rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  border: none;
  text-decoration: none;
  transition: all 0.2s;
}

.btn-primary {
  background: var(--primary);
  color: white;
}

.btn-primary:hover {
  background: var(--primary-dark);
  transform: translateY(-1px);
}

.btn-secondary {
  background: var(--bg-alt);
  color: var(--text);
  border: 1px solid var(--border);
}

.btn-secondary:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.btn-sm {
  padding: 0.45rem 0.9rem;
  font-size: 0.85rem;
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

/* ===== Sections ===== */
.section {
  padding: 4rem 0;
}

.section-alt {
  background: var(--bg-alt);
}

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  text-align: center;
  margin-bottom: 0.5rem;
}

.section-sub {
  text-align: center;
  color: var(--text-muted);
  max-width: 560px;
  margin: 0 auto 2.5rem;
}

/* ===== Subjects ===== */
.subject-filters {
  display: flex;
  justify-content: center;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}

.filter-btn {
  padding: 0.45rem 1rem;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text-muted);
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.filter-btn.active,
.filter-btn:hover {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}

.subjects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1.25rem;
}

.subject-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.4rem;
  cursor: pointer;
  transition: all 0.25s;
  box-shadow: var(--shadow);
}

.subject-card:hover {
  transform: translateY(-4px);
  border-color: var(--primary);
  box-shadow: 0 12px 20px -8px rgb(13 148 136 / 0.25);
}

.subject-card .icon {
  font-size: 1.8rem;
  margin-bottom: 0.6rem;
}

.subject-card h3 {
  font-size: 1.1rem;
  margin-bottom: 0.3rem;
}

.subject-card p {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.subject-card .tag {
  display: inline-block;
  margin-top: 0.7rem;
  font-size: 0.7rem;
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
  background: color-mix(in srgb, var(--primary) 15%, transparent);
  color: var(--primary);
  font-weight: 600;
}

/* ===== Modal ===== */
.modal {
  position: fixed;
  inset: 0;
  background: rgb(0 0 0 / 0.5);
  display: grid;
  place-items: center;
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: 0.25s;
  padding: 1rem;
}

.modal.open {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: var(--card);
  border-radius: var(--radius);
  max-width: 640px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 2rem;
  position: relative;
  box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
}

.modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: none;
  border: none;
  font-size: 1.6rem;
  cursor: pointer;
  color: var(--text-muted);
  line-height: 1;
}

.modal-body h2 {
  margin-bottom: 0.5rem;
  color: var(--primary);
}

.modal-body h3 {
  margin: 1.2rem 0 0.4rem;
  font-size: 1rem;
}

.modal-body ul {
  padding-left: 1.2rem;
  color: var(--text-muted);
  font-size: 0.95rem;
}

.modal-body li {
  margin-bottom: 0.3rem;
}

/* ===== Quizzes ===== */
.quiz-selector {
  display: flex;
  gap: 0.8rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}

.quiz-selector select {
  padding: 0.65rem 1rem;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  font-size: 0.95rem;
  min-width: 160px;
}

.quiz-container {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.8rem;
  max-width: 700px;
  margin: 0 auto;
  box-shadow: var(--shadow);
}

.quiz-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 1.2rem;
  font-size: 0.9rem;
  color: var(--text-muted);
}

.quiz-question {
  font-size: 1.15rem;
  font-weight: 500;
  margin-bottom: 1.4rem;
  line-height: 1.5;
}

.quiz-options {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.quiz-option {
  padding: 0.9rem 1.1rem;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  background: var(--bg);
  cursor: pointer;
  transition: all 0.2s;
  text-align: left;
  font-size: 0.95rem;
}

.quiz-option:hover:not(.disabled) {
  border-color: var(--primary);
  background: color-mix(in srgb, var(--primary) 8%, var(--bg));
}

.quiz-option.correct {
  border-color: var(--success);
  background: color-mix(in srgb, var(--success) 15%, var(--bg));
}

.quiz-option.wrong {
  border-color: var(--error);
  background: color-mix(in srgb, var(--error) 12%, var(--bg));
}

.quiz-option.disabled {
  cursor: default;
}

.quiz-feedback {
  margin-top: 1.2rem;
  padding: 1rem;
  border-radius: 8px;
  background: var(--bg-alt);
  font-size: 0.95rem;
}

.quiz-feedback.correct {
  border-left: 4px solid var(--success);
}

.quiz-feedback.wrong {
  border-left: 4px solid var(--error);
}

.quiz-nav {
  margin-top: 1.5rem;
  display: flex;
  gap: 0.8rem;
  justify-content: flex-end;
}

.quiz-results {
  text-align: center;
  max-width: 480px;
  margin: 0 auto;
  background: var(--card);
  padding: 2.5rem;
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

.results-score {
  font-size: 3rem;
  font-weight: 700;
  color: var(--primary);
  margin: 1rem 0;
}

.hidden {
  display: none !important;
}

/* ===== Past Questions ===== */
.pastqs-controls {
  display: flex;
  gap: 0.8rem;
  justify-content: center;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}

.pastqs-controls select {
  padding: 0.65rem 1rem;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
}

.pastqs-list {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  max-width: 800px;
  margin: 0 auto;
}

.pastq-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.4rem;
  box-shadow: var(--shadow);
}

.pastq-card .meta {
  font-size: 0.8rem;
  color: var(--primary);
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.pastq-card .question {
  font-weight: 500;
  margin-bottom: 0.8rem;
}

.pastq-card .options {
  list-style: none;
  margin-bottom: 0.8rem;
}

.pastq-card .options li {
  padding: 0.35rem 0;
  font-size: 0.9rem;
  color: var(--text-muted);
}

.pastq-card .answer {
  font-size: 0.9rem;
  padding: 0.7rem;
  background: color-mix(in srgb, var(--success) 12%, var(--bg));
  border-radius: 6px;
  border-left: 3px solid var(--success);
}

.pastq-card .answer strong {
  color: var(--success);
}

/* ===== Tools ===== */
.tools-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.4rem;
}

.tool-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  box-shadow: var(--shadow);
}

.tool-card h3 {
  margin-bottom: 1rem;
  font-size: 1.1rem;
}

.timer-display {
  font-size: 3rem;
  font-weight: 700;
  text-align: center;
  font-variant-numeric: tabular-nums;
  color: var(--primary);
  margin-bottom: 1rem;
}

.timer-controls {
  display: flex;
  gap: 0.5rem;
  justify-content: center;
  margin-bottom: 1rem;
}

.timer-modes {
  display: flex;
  gap: 0.4rem;
  justify-content: center;
}

.mode-btn {
  padding: 0.3rem 0.7rem;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--bg);
  font-size: 0.8rem;
  cursor: pointer;
  color: var(--text-muted);
}

.mode-btn.active {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}

/* Flashcard */
.flashcard {
  perspective: 1000px;
  height: 160px;
  margin-bottom: 1rem;
}

.flashcard-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.5s;
  transform-style: preserve-3d;
}

.flashcard.flipped .flashcard-inner {
  transform: rotateY(180deg);
}

.flashcard-front,
.flashcard-back {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  display: grid;
  place-items: center;
  padding: 1rem;
  border-radius: 8px;
  background: var(--bg-alt);
  border: 1px solid var(--border);
  text-align: center;
  font-size: 0.95rem;
}

.flashcard-back {
  transform: rotateY(180deg);
  background: color-mix(in srgb, var(--primary) 12%, var(--bg));
  border-color: var(--primary);
}

.flashcard-controls {
  display: flex;
  gap: 0.5rem;
  justify-content: center;
}

.daily-challenge {
  text-align: center;
}

/* ===== Resources ===== */
.resources-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1.2rem;
}

.resource-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.3rem;
  text-decoration: none;
  color: var(--text);
  transition: all 0.25s;
  box-shadow: var(--shadow);
}

.resource-card:hover {
  border-color: var(--primary);
  transform: translateY(-3px);
}

.resource-card h4 {
  color: var(--primary);
  margin-bottom: 0.4rem;
}

.resource-card p {
  font-size: 0.88rem;
  color: var(--text-muted);
}

/* ===== Tips ===== */
.tips-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.2rem;
}

.tip-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.3rem;
  box-shadow: var(--shadow);
}

.tip-card h4 {
  margin-bottom: 0.4rem;
  color: var(--primary);
}

.tip-card p {
  font-size: 0.92rem;
  color: var(--text-muted);
}

/* ===== Footer ===== */
.footer {
  padding: 2.5rem 0;
  background: var(--bg-alt);
  border-top: 1px solid var(--border);
  text-align: center;
}

.footer p {
  margin-bottom: 0.5rem;
}

.footer-note {
  font-size: 0.8rem;
  color: var(--text-muted);
  max-width: 600px;
  margin: 0.8rem auto;
}

.footer-copy {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-top: 1rem;
}

/* ===== Responsive ===== */
@media (max-width: 768px) {
  .nav-links {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    background: var(--card);
    flex-direction: column;
    padding: 1.5rem;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    transform: translateY(-120%);
    opacity: 0;
    transition: 0.3s;
    z-index: 99;
  }

  .nav-links.open {
    transform: translateY(0);
    opacity: 1;
  }

  .nav-toggle {
    display: flex;
  }

  .hero {
    padding: 3rem 0 2.5rem;
  }

  .quiz-selector {
    flex-direction: column;
    align-items: stretch;
  }

  .quiz-selector select,
  .quiz-selector .btn {
    width: 100%;
  }

  .search-wrap input {
    font-size: 16px; /* prevents zoom on iOS */
  }

  .year-filters {
    justify-content: flex-start;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
}

/* ===== Search ===== */
.search-wrap {
  max-width: 420px;
  margin: 0 auto 1.5rem;
}

.search-wrap input {
  width: 100%;
  padding: 0.75rem 1.1rem;
  border-radius: 999px;
  border: 1.5px solid var(--border);
  background: var(--card);
  color: var(--text);
  font-size: 0.95rem;
  outline: none;
  transition: border-color 0.2s;
}

.search-wrap input:focus {
  border-color: var(--primary);
}

/* ===== Year filters ===== */
.year-filters {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 1.8rem;
}

.filter-label {
  font-size: 0.85rem;
  color: var(--text-muted);
  font-weight: 500;
  margin-right: 0.3rem;
}

.year-btn {
  font-size: 0.8rem;
  padding: 0.35rem 0.8rem;
}

/* ===== Subject card star ===== */
.subject-card {
  position: relative;
}

.fav-btn {
  position: absolute;
  top: 0.8rem;
  right: 0.8rem;
  background: none;
  border: none;
  font-size: 1.25rem;
  cursor: pointer;
  opacity: 0.45;
  transition: 0.2s;
  line-height: 1;
  z-index: 2;
}

.fav-btn:hover,
.fav-btn.active {
  opacity: 1;
  transform: scale(1.15);
}

.fav-btn.active {
  color: #f59e0b;
}

.subject-card .year-badge {
  display: inline-block;
  margin-top: 0.4rem;
  margin-right: 0.4rem;
  font-size: 0.68rem;
  padding: 0.15rem 0.45rem;
  border-radius: 4px;
  background: var(--bg-alt);
  color: var(--text-muted);
  font-weight: 600;
}

/* ===== Notes in modal ===== */
.notes-box {
  margin-top: 1.2rem;
  padding: 1rem;
  background: color-mix(in srgb, var(--primary) 8%, var(--bg));
  border-radius: 8px;
  border-left: 3px solid var(--primary);
  font-size: 0.92rem;
}

.notes-box h4 {
  margin-bottom: 0.4rem;
  color: var(--primary);
}

.notes-box ul {
  padding-left: 1.1rem;
  margin: 0;
}

/* ===== Expandable past questions ===== */
.pastq-card .answer {
  display: none;
}

.pastq-card.revealed .answer {
  display: block;
}

.show-answer-btn {
  margin-top: 0.6rem;
  font-size: 0.85rem;
  padding: 0.4rem 0.9rem;
}

/* ===== Favourites empty state ===== */
.empty-fav {
  text-align: center;
  color: var(--text-muted);
  grid-column: 1 / -1;
  padding: 2rem;
}

/* ===== Better mobile touch targets ===== */
@media (max-width: 768px) {
  .fav-btn {
    font-size: 1.4rem;
    top: 0.6rem;
    right: 0.6rem;
  }

  .filter-btn {
    padding: 0.5rem 0.9rem;
  }
}

/* ===== Premium polish ===== */
.subject-card,
.tool-card,
.resource-card,
.tip-card,
.pastq-card {
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.btn-primary:hover {
  box-shadow: 0 6px 16px -4px rgb(13 148 136 / 0.45);
}

.hero {
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  inset: -40% -20% auto;
  height: 80%;
  background: radial-gradient(ellipse, color-mix(in srgb, var(--primary) 18%, transparent), transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.hero-content {
  position: relative;
  z-index: 1;
}

/* ===== OSCE ===== */
.osce-controls {
  display: flex;
  gap: 0.7rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}

.osce-controls select {
  padding: 0.65rem 1rem;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
}

.osce-checklist {
  max-width: 640px;
  margin: 0 auto;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.4rem;
  box-shadow: var(--shadow);
}

.osce-item {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
  padding: 0.65rem 0;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
}

.osce-item:last-child { border-bottom: none; }

.osce-item input {
  margin-top: 0.25rem;
  width: 1.1rem;
  height: 1.1rem;
  accent-color: var(--primary);
}

.osce-item.done span {
  text-decoration: line-through;
  color: var(--text-muted);
}

.osce-progress {
  margin-bottom: 1rem;
  font-size: 0.9rem;
  color: var(--text-muted);
}

/* ===== SRS Flashcards ===== */
.tool-card-wide { grid-column: 1 / -1; }

@media (min-width: 700px) {
  .tools-grid { grid-template-columns: repeat(2, 1fr); }
  .tool-card-wide { grid-column: 1 / -1; }
}

.srs-controls { flex-wrap: wrap; gap: 0.4rem; }
.srs-again { background: #ef4444; color: #fff; border: none; }
.srs-hard { background: #f59e0b; color: #fff; border: none; }
.srs-good { background: #10b981; color: #fff; border: none; }
.srs-easy { background: #0d9488; color: #fff; border: none; }

.srs-hint {
  text-align: center;
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-top: 0.6rem;
}

.sync-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.8rem;
}

/* ===== Planner ===== */
.planner-wrap { max-width: 900px; margin: 0 auto; }

.planner-add {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-bottom: 1.5rem;
  justify-content: center;
}

.planner-add select,
.planner-add input {
  padding: 0.6rem 0.9rem;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  font-size: 0.9rem;
}

.planner-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
  margin-bottom: 1rem;
}

.planner-day {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1rem;
  min-height: 120px;
  box-shadow: var(--shadow);
}

.planner-day h4 {
  font-size: 0.95rem;
  margin-bottom: 0.6rem;
  color: var(--primary);
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.4rem;
}

.plan-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.85rem;
  padding: 0.35rem 0;
  gap: 0.4rem;
}

.plan-item button {
  background: none;
  border: none;
  color: var(--error);
  cursor: pointer;
  font-size: 1rem;
  line-height: 1;
}

@media print {
  .navbar, .hero-cta, .theme-toggle, .nav-toggle, footer, .search-wrap, .subject-filters {
    display: none !important;
  }
}
